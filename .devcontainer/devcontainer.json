{
  "name": "AnzuCloud Kali Desktop",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "forwardPorts": [6080, 5901],
  "portsAttributes": {
    "6080": {
      "label": "Desktop (noVNC)",
      "onAutoForward": "openBrowser"
    },
    "5901": {
      "label": "VNC",
      "onAutoForward": "ignore"
    }
  },
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "postCreateCommand": "echo 'AnzuCloud Kali setup complete'",
  "postStartCommand": "supervisord -c /etc/supervisor/conf.d/desktop.conf",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}