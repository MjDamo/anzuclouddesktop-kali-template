{
  "name": "AnzuCloud Kali Desktop",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "forwardPorts": [6080, 5901],
  "portsAttributes": {
    "6080": {
      "label": "Desktop (noVNC)",
      "onAutoForward": "notify"
    },
    "5901": {
      "label": "VNC",
      "onAutoForward": "ignore"
    }
  },
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "postCreateCommand": "sudo chmod +x /usr/local/bin/start-desktop.sh",
  "postStartCommand": "/usr/local/bin/start-desktop.sh",
  "postAttachCommand": {
    "desktop": "/usr/local/bin/start-desktop.sh"
  }
}