{
  "name": "AnzuCloud Kali Desktop",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [6080, 5901],
  "portsAttributes": {
    "6080": {
      "label": "Desktop (noVNC)",
      "onAutoForward": "openBrowser"
    },
    "5901": {
      "label": "VNC",
      "onAutoForward": "ignore"
    }
  },
  "remoteUser": "vscode",
  "postStartCommand": "nohup supervisord -c /etc/supervisor/conf.d/supervisord.conf > /tmp/supervisor.out 2>&1 &",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}